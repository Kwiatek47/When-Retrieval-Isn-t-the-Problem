# MedChat API / Ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=400
OLLAMA_NUM_CTX=2048
QUERY_REWRITE_MODEL=qwen2.5:7b
QUERY_REWRITE_TIMEOUT=15
PROMPT_VERSION=v4

# RAG API
EMBEDDING_SERVICE_URL=http://localhost:8081
EMBEDDING_TIMEOUT=30
EMBEDDING_DIMENSION=768
RAG_RETRIEVER=embedding_service
RAG_CORPUS_VERSION=
RAG_CANDIDATE_K=50
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_EXCERPT_CHARS=1600
RAG_ADAPTIVE_RETRIEVAL_ENABLED=true
RAG_ADAPTIVE_MAX_ROUNDS=1
RAG_RETRIEVAL_EXPANSION_MULTIPLIER=2
RAG_RETRIEVAL_EXPANDED_LIMIT_MAX=100
RAG_EVIDENCE_FILTER_ENABLED=true
RAG_EVIDENCE_JUDGE_ENABLED=true
RAG_EVIDENCE_JUDGE_METHOD=llm
RAG_EVIDENCE_JUDGE_MODEL=
RAG_EVIDENCE_JUDGE_MAX_SOURCES=3
RAG_EVIDENCE_JUDGE_VOTING_ENABLED=false
RAG_EVIDENCE_JUDGE_VOTES=3
RAG_REFUSE_ON_LOW_EVIDENCE=true
RAG_CITATION_REPAIR_ENABLED=true
RAG_ANSWER_QUALITY_GATE_ENABLED=true
RAG_ANSWER_QUALITY_MAX_HALLUCINATION_RATE=0.25
RAG_EXTRACTIVE_FALLBACK_ENABLED=true

# Answer quality
ANSWER_QUALITY_METHOD=semantic_similarity
ANSWER_QUALITY_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ANSWER_QUALITY_SIMILARITY_THRESHOLD=0.45

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_TIMEOUT=10
QDRANT_COLLECTION=MedicalChunk_pubmed_reviews_v1_medcpt_20260518
# NICE pilot example:
# QDRANT_COLLECTION=MedicalChunk_nice_pilot_medcpt_20260603
QDRANT_VECTOR_NAME=medcpt_dense
QDRANT_SPARSE_VECTOR_NAME=bm25_sparse
QDRANT_VECTOR_SIZE=768
QDRANT_RECREATE_COLLECTION=false
QDRANT_URL=http://localhost:6333

# Embedding service
EMBEDDING_MODEL_NAME=medcpt-ncbi-v1
MEDCPT_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
MEDCPT_DOCUMENT_MODEL=ncbi/MedCPT-Article-Encoder
MEDCPT_QUERY_MAX_LENGTH=64
MEDCPT_DOCUMENT_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
# Do not set HF_HOME for host `make dev`; Docker sets /models/huggingface in docker-compose.yml.
BM25_STATS_PATH=data/bm25_stats.json

# Local runtime outputs
TELEMETRY_PATH=data/telemetry/events.jsonl
PUBMED_SAMPLE_PATH=data/sample/pubmed_sample.json
CORPUS_VERSION=pubmed-sample-v1
# NICE pilot example:
# RAG_CORPUS_VERSION=nice-guidelines-v1
# CORPUS_VERSION=nice-guidelines-v1
